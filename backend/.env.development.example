# Development only. Copy to .env and replace every placeholder; never commit .env.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=el_fatoura_development
DB_USER=el_fatoura_dev
DB_PASS=replace_with_development_password
APP_ENV=development
AI_DEBUG_ENABLED=false
MAX_REQUEST_BYTES=67108864
MAX_EXECUTION_SECONDS=60
JWT_SECRET=generate_a_unique_development_secret_of_at_least_32_characters
JWT_ISSUER=el_fatoura_development
TWO_FACTOR_ENCRYPTION_KEY=replace_with_unique_base64_32_byte_development_key
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200
APP_LOG_PATH=
APP_LOG_MAX_BYTES=10485760
ERROR_MONITOR_WEBHOOK_URL=
ERROR_MONITOR_WEBHOOK_SECRET=
UPTIME_READY_URL=http://localhost/backend/health/ready.php
BACKUP_ENCRYPTION_KEY=generate_unique_development_backup_secret
BACKUP_OUTPUT_DIR=/absolute/private/path/el-fatoura-development/backups
BACKUP_OFFSITE_DIR=
BACKUP_DAILY_RETENTION=7
BACKUP_WEEKLY_RETENTION=4
RESTORE_DB_USER=el_fatoura_dev_restore
RESTORE_DB_PASS=replace_with_development_restore_password
MAIL_HOST=smtp.development.example
MAIL_PORT=587
MAIL_USERNAME=development_mail_user
MAIL_PASSWORD=replace_with_development_mail_password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=development@example.invalid
MAIL_FROM_NAME=El Fatoura Development
EL_FATOURA_EXTRACTOR_DIR=
EXTRACTOR_TIMEOUT_SECONDS=60
EXTRACTOR_MAX_OUTPUT_BYTES=2097152
PRIVATE_STORAGE_DIR=/absolute/private/path/el-fatoura-development/documents
