# Production only. Inject real values from the deployment secret store; never commit them.
DB_HOST=production_database_host
DB_PORT=3306
DB_NAME=el_fatoura_production
DB_USER=el_fatoura_production
DB_PASS=replace_with_production_password
APP_ENV=production
AI_DEBUG_ENABLED=false
MAX_REQUEST_BYTES=67108864
MAX_EXECUTION_SECONDS=60
JWT_SECRET=generate_a_unique_production_secret_of_at_least_32_characters
JWT_ISSUER=el_fatoura_production
TWO_FACTOR_ENCRYPTION_KEY=replace_with_unique_base64_32_byte_production_key
CORS_ALLOWED_ORIGINS=https://app.example.com
APP_LOG_PATH=
APP_LOG_MAX_BYTES=10485760
ERROR_MONITOR_WEBHOOK_URL=https://monitoring.example.com/events
ERROR_MONITOR_WEBHOOK_SECRET=replace_with_production_monitor_secret
UPTIME_READY_URL=https://api.example.com/backend/health/ready.php
BACKUP_ENCRYPTION_KEY=generate_unique_production_backup_secret
BACKUP_OUTPUT_DIR=/absolute/private/path/el-fatoura-production/backups
BACKUP_OFFSITE_DIR=/absolute/offsite/path/el-fatoura-production
BACKUP_DAILY_RETENTION=14
BACKUP_WEEKLY_RETENTION=8
RESTORE_DB_USER=el_fatoura_production_restore
RESTORE_DB_PASS=replace_with_production_restore_password
MAIL_HOST=smtp.production.example
MAIL_PORT=587
MAIL_USERNAME=production_mail_user
MAIL_PASSWORD=replace_with_production_mail_password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=billing@example.invalid
MAIL_FROM_NAME=El Fatoura
EL_FATOURA_EXTRACTOR_DIR=
EXTRACTOR_TIMEOUT_SECONDS=60
EXTRACTOR_MAX_OUTPUT_BYTES=2097152
PRIVATE_STORAGE_DIR=/absolute/private/path/el-fatoura-production/documents
SERVER_DASHBOARD_ACCESS_KEY=
SERVER_DASHBOARD_SQL_ENABLED=false
SERVER_DASHBOARD_REQUIRE_HTTPS=true
SERVER_DASHBOARD_ALLOWED_IPS=203.0.113.10
SUPER_ADMIN_DB_HOST=production_database_host
SUPER_ADMIN_DB_PORT=3306
SUPER_ADMIN_DB_NAME=el_fatoura_production
SUPER_ADMIN_DB_USER=el_fatoura_schema_admin
SUPER_ADMIN_DB_PASS=replace_with_schema_admin_password
