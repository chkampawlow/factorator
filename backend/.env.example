# Copy this file to .env and replace every placeholder locally.
# Never commit the real .env file.

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=change_me
DB_USER=change_me
DB_PASS=change_me

APP_ENV=development
AI_DEBUG_ENABLED=false
MAX_REQUEST_BYTES=67108864
MAX_EXECUTION_SECONDS=60

JWT_SECRET=generate_at_least_32_random_characters_here
JWT_ISSUER=facturation_app
TWO_FACTOR_ENCRYPTION_KEY=generate_with_openssl_rand_base64_32

# Comma-separated browser origins. Do not use * in production.
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

# Optional JSON-lines application log settings.
APP_LOG_PATH=
APP_LOG_MAX_BYTES=10485760

# Optional centralized error alert receiver. Only redacted ERROR/CRITICAL events are sent.
ERROR_MONITOR_WEBHOOK_URL=
ERROR_MONITOR_WEBHOOK_SECRET=
UPTIME_READY_URL=https://example.com/backend/health/ready.php

# Encrypted backups. Generate a unique secret of at least 32 random characters.
BACKUP_ENCRYPTION_KEY=
BACKUP_OUTPUT_DIR=
BACKUP_OFFSITE_DIR=
BACKUP_DAILY_RETENTION=14
BACKUP_WEEKLY_RETENTION=8
# Optional separate database account used only for isolated restore drills.
RESTORE_DB_USER=
RESTORE_DB_PASS=

MAIL_HOST=change_me
MAIL_PORT=587
MAIL_USERNAME=change_me
MAIL_PASSWORD=change_me
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=change_me@example.com
MAIL_FROM_NAME=El Fatoura

# Optional local document extractor directory.
EL_FATOURA_EXTRACTOR_DIR=
EXTRACTOR_TIMEOUT_SECONDS=60
EXTRACTOR_MAX_OUTPUT_BYTES=2097152

# Private documents and temporary uploads. Must be outside the public web root.
PRIVATE_STORAGE_DIR=/absolute/path/outside/htdocs/el-fatoura-private

# Optional standalone Super Admin portal (/server_dashboard.php).
# Use a unique random secret of at least 24 characters and HTTPS in production.
SERVER_DASHBOARD_ACCESS_KEY=
SERVER_DASHBOARD_SQL_ENABLED=false
SERVER_DASHBOARD_REQUIRE_HTTPS=true
# Optional comma-separated IP allowlist. Empty permits any IP with the access key.
SERVER_DASHBOARD_ALLOWED_IPS=
# Optional privileged database account for schema migrations. If empty, DB_* is used.
SUPER_ADMIN_DB_HOST=
SUPER_ADMIN_DB_PORT=3306
SUPER_ADMIN_DB_NAME=
SUPER_ADMIN_DB_USER=
SUPER_ADMIN_DB_PASS=
