# Staging only. Copy to .env during deployment and inject real staging secrets.
DB_HOST=staging_database_host
DB_PORT=3306
DB_NAME=el_fatoura_staging
DB_USER=el_fatoura_staging
DB_PASS=replace_with_staging_password
APP_ENV=staging
AI_DEBUG_ENABLED=false
MAX_REQUEST_BYTES=67108864
MAX_EXECUTION_SECONDS=60
JWT_SECRET=generate_a_unique_staging_secret_of_at_least_32_characters
JWT_ISSUER=el_fatoura_staging
TWO_FACTOR_ENCRYPTION_KEY=replace_with_unique_base64_32_byte_staging_key
CORS_ALLOWED_ORIGINS=https://staging.example.com
APP_LOG_PATH=
APP_LOG_MAX_BYTES=10485760
ERROR_MONITOR_WEBHOOK_URL=https://monitoring-staging.example.com/events
ERROR_MONITOR_WEBHOOK_SECRET=replace_with_staging_monitor_secret
UPTIME_READY_URL=https://api-staging.example.com/backend/health/ready.php
BACKUP_ENCRYPTION_KEY=generate_unique_staging_backup_secret
BACKUP_OUTPUT_DIR=/absolute/private/path/el-fatoura-staging/backups
BACKUP_OFFSITE_DIR=/absolute/offsite/path/el-fatoura-staging
BACKUP_DAILY_RETENTION=7
BACKUP_WEEKLY_RETENTION=4
RESTORE_DB_USER=el_fatoura_staging_restore
RESTORE_DB_PASS=replace_with_staging_restore_password
MAIL_HOST=smtp.staging.example
MAIL_PORT=587
MAIL_USERNAME=staging_mail_user
MAIL_PASSWORD=replace_with_staging_mail_password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=staging@example.invalid
MAIL_FROM_NAME=El Fatoura Staging
EL_FATOURA_EXTRACTOR_DIR=
EXTRACTOR_TIMEOUT_SECONDS=60
EXTRACTOR_MAX_OUTPUT_BYTES=2097152
PRIVATE_STORAGE_DIR=/absolute/private/path/el-fatoura-staging/documents
