RewriteEngine On
Options -Indexes

LimitRequestBody 67108864
php_value post_max_size 64M
php_value upload_max_filesize 16M
php_value max_execution_time 60

<FilesMatch "^\.env(?:\..*)?$">
    Require all denied
</FilesMatch>

<FilesMatch "(?i)^(?:composer\.(?:json|lock)|.*\.(?:pem|key|p12|pfx|jks|keystore|bak|dump|sql|sql\.enc|tar\.enc))$">
    Require all denied
</FilesMatch>

RewriteCond %{HTTP:Authorization} ^(.*)
RewriteRule .* - [E=HTTP_AUTHORIZATION:%1]

RewriteCond %{HTTP:X-Access-Token} ^(.*)
RewriteRule .* - [E=HTTP_X_ACCESS_TOKEN:%1]
